{% set resume = wulitou_resume() %}
<footer class="wr-footer">
  {% if theme.theme_options.decorations !== false %}
  <img class="wr-footer__deco" src="{{ wulitou_asset('smiley.png') }}" alt="" aria-hidden="true" width="30" height="30" loading="lazy" decoding="async">
  {% endif %}

  <p class="wr-footer__text">
    {%- if resume.footer.text -%}
      {{ resume.footer.text }}
    {%- else -%}
      {{ resume.footer.copyright | default('©') }} {{ wulitou_year() }}
      {%- if resume.name %} {{ resume.name }}{% endif -%}
      · 用 <a href="https://hexo.io" target="_blank" rel="noopener noreferrer">Hexo</a> 与 <a href="https://github.com/yigeFYW/wulitou_resume" target="_blank">无厘头简历</a> 搭建
    {%- endif -%}
  </p>

  {%- if resume.footer.icp -%}
  <a class="wr-footer__icp" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{{ resume.footer.icp }}</a>
  {%- endif -%}
</footer>
