# 七牛云对象存储与 CDN 配置
# 复制为 .env 后填写真实值；.env 已被 git 忽略
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=

# 可填写 Zone_z0 / Zone_z1 / Zone_z2 / Zone_na0 / Zone_as0，或 z0 / z1 / z2 / na0 / as0
QINIU_ZONE=Zone_z2

# CDN 加速域名，不要填写末尾文件路径或查询参数
QINIU_DOMAIN=https://cdn.example.com

# 可选：与 Hexo 的 root 保持一致。
# 当前 _config.yml 使用 root: /，因此留空；如果使用 root: /resume-blog/，填 resume-blog。
QINIU_KEY_PREFIX=
